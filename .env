MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=cyberwatch

JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=http://localhost:5173

# Enrichissement pendant la COLLECTE (NVD, MITRE, OSV, Red Hat, GitHub, MSRC interrogés par
# identifiant CVE). false = la collecte s'en tient aux sources configurées par l'admin :
# beaucoup plus rapide, mais score CVSS/sévérité/références nettement moins complets.
# L'enrichissement à la demande (ouverture d'une fiche CVE) reste actif dans les deux cas.
ENRICHMENT_ENABLED=false

# Optional - if unset, sent e-mails are logged instead of actually delivered
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@cyberwatch.ai

# --- Agent IA de l'assistant ---
# 1) Reformule/résume les CVE réellement collectées en base (bridage strict, zéro invention).
# 2) Répond aux questions générales de cybersécurité hors base (réponses étiquetées « hors base »).
# Vérification : GET http://127.0.0.1:8000/consultant/assistant/health
#
# La clé ci-dessous commence par « gsk_ » : c'est une clé GROQ (groq.com), à ne pas confondre
# avec GROK de xAI (clés « xai-… »). Pour basculer sur xAI : LLM_PROVIDER=grok + clé « xai-… ».
# Modèles Groq disponibles : openai/gpt-oss-120b (défaut), llama-3.3-70b-versatile,
# llama-3.1-8b-instant (le plus rapide), qwen/qwen3.6-27b.
LLM_PROVIDER=groq
LLM_API_KEY=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
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT=45

# Réponses hors base autorisées (false = mode strictement documentaire).
ASSISTANT_EXTERNAL_ANSWERS=true
