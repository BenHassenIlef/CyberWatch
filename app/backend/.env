MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=cyberwatch

JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=http://localhost:5173

# Optional - if unset, sent e-mails are logged instead of actually delivered
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@cyberwatch.ai

# --- Agent IA de l'assistant ---
# NB : uvicorn démarre depuis la racine du projet -> c'est le .env RACINE qui est chargé.
# Ce fichier sert de copie locale ; gardez les deux cohérents.
LLM_PROVIDER=groq
LLM_API_KEY=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
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT=45
ASSISTANT_EXTERNAL_ANSWERS=true
