MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=cyberwatch

JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=http://localhost:5173

# Clé de chiffrement des secrets de sources (API Key, Bearer, OAuth...).
# Générer une clé Fernet dédiée en production :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si laissée vide, une clé est dérivée de JWT_SECRET (suffisant en développement).
CREDENTIALS_ENCRYPTION_KEY=

# --- Déclencheur de la collecte quotidienne ---
# "external" (RECOMMANDÉ) : la Tâche planifiée Windows lance collect_once.py à 08:00 ; la
#   collecte NE dépend plus d'une fenêtre Uvicorn ouverte. Voir docs/SCHEDULING.md.
# "internal" : le scheduler interne de FastAPI déclenche la collecte (nécessite Uvicorn allumé).
COLLECTION_TRIGGER=external
# Plafond de rendus Chromium simultanés (anti-« thrash » des sources HTML). 2–4 conseillé.
RENDER_CONCURRENCY=3

# --- Agent IA de l'assistant ---
# Deux usages :
#   1) Reformuler/résumer les CVE DÉJÀ récupérées en base (bridage strict, jamais d'invention).
#   2) Répondre aux questions GÉNÉRALES de cybersécurité hors base (voir ASSISTANT_EXTERNAL_ANSWERS).
# Laisser LLM_PROVIDER vide -> synthèse déterministe ancrée + refus des questions externes.
#   LLM_PROVIDER : groq | grok (alias xai) | anthropic | openai
#      « groq » = groq.com, clés « gsk_… » (https://console.groq.com/keys)
#      « grok » = xAI,      clés « xai-… » (https://console.x.ai)
#      -> noms quasi identiques, fournisseurs différents : vérifiez le préfixe de votre clé.
#   LLM_MODEL    : vide = openai/gpt-oss-120b (Groq) ou grok-4 (xAI)
#   LLM_BASE_URL : vide = URL officielle du fournisseur (à renseigner derrière un proxy)
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT=45

# Autorise l'assistant à répondre AUX QUESTIONS EXTERNES (hors base CyberWatch AI).
# Ces réponses sont étiquetées « hors base » dans l'API et dans l'interface.
# false = mode strictement documentaire (comportement historique).
ASSISTANT_EXTERNAL_ANSWERS=true
