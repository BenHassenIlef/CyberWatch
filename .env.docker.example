# =====================================================================
#  CyberWatch AI - Modele de configuration pour Docker
#
#      cp .env.docker.example .env
#
#  Les variables MONGO_URI, CORS_ORIGINS et COLLECTION_TRIGGER sont imposees par
#  docker-compose.yml (section `environment`) : inutile de les definir ici, elles
#  seraient ecrasees.
#
#  Ce fichier est LU A L'EXECUTION et n'entre jamais dans une image (.dockerignore).
# =====================================================================

# --- Securite -------------------------------------------------------------------------
# OBLIGATOIRE en production : generez une valeur longue et aleatoire.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=changez-cette-valeur-par-un-secret-long-et-aleatoire
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Collecte -------------------------------------------------------------------------
# Cle API NVD (gratuite, https://nvd.nist.gov/developers/request-an-api-key).
# Sans cle : 6,5 s imposees entre deux appels. Avec cle : 0,7 s.
NVD_API_KEY=

# Enrichissement multi-sources pendant la collecte (NVD, MITRE, OSV, Red Hat, GitHub, MSRC).
# false = la collecte s'en tient aux sources configurees par l'administrateur (bien plus
# rapide, mais score CVSS et references nettement moins complets).
ENRICHMENT_ENABLED=true

# Fuseau horaire du planificateur (nom IANA). Vide = fuseau du conteneur (UTC).
# Renseignez-le, sinon « aujourd'hui » ne designera pas la meme journee que chez vous.
SCHEDULER_TIMEZONE=Africa/Tunis

# --- Notifications par e-mail ----------------------------------------------------------
# Vide = les e-mails sont journalises au lieu d'etre envoyes (pratique en developpement).
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@cyberwatch.ai

# INTERRUPTEUR GENERAL des notifications par courriel. Sans lui a « true », tout le reste
# de la configuration SMTP reste sans effet et l'application n'envoie rien, en silence.
EMAIL_NOTIFICATIONS_ENABLED=true

# DESTINATAIRES de la veille, separes par des virgules. Ils s'ajoutent aux consultants
# inscrits dans l'application. A ne pas confondre avec SMTP_USER, qui est le compte
# EXPEDITEUR : l'un envoie, les autres recoivent.
NOTIFY_EXTRA_RECIPIENTS=

# Liste EXCLUSIVE de destinataires (virgules). Renseignee, elle REMPLACE la selection
# automatique : seules ces adresses recoivent la veille, aucun compte consultant n y est
# ajoute -- pas meme apres une nouvelle connexion ou la creation d un compte.
# A employer quand la veille doit partir vers une boite de service unique.
# Laissee vide, les consultants actifs sont prevenus comme auparavant.
NOTIFY_ONLY_RECIPIENTS=

# --- Microsoft 365 -------------------------------------------------------------------
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=true
#   SMTP_USER=cyberwatch@entreprise.fr      compte d'envoi DEDIE, pas une boite nominative
#   SMTP_FROM=cyberwatch@entreprise.fr      doit valoir SMTP_USER : M365 refuse un autre
#
# L'authentification SMTP est DESACTIVEE par defaut sur chaque boite depuis 2023.
# L'administrateur du locataire doit l'autoriser pour ce compte :
#   Set-CASMailbox -Identity cyberwatch@entreprise.fr -SmtpClientAuthenticationDisabled $false
# Sans cela, le serveur repond « basic authentication is disabled » — et le mot de passe
# n'est pas en cause.

# --- Assistant IA (optionnel) ----------------------------------------------------------
# Fournisseurs : groq | grok (xAI) | openai | anthropic.
# NB : « Groq » (cles gsk_...) et « Grok » de xAI (cles xai-...) sont deux services distincts.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT=45
ASSISTANT_EXTERNAL_ANSWERS=true

# --- Frontend ---------------------------------------------------------------------------
# URL de l'API vue par le NAVIGATEUR. Incrustee au BUILD du frontend : apres modification,
# relancez `docker compose build frontend`.
VITE_API_URL=http://localhost:8000

# --- Identifiants des sources ---------------------------------------------------------
# Chiffre les identifiants d'API que l'administrateur saisit dans l'interface (sources
# protegees). Sans valeur, ils sont stockes en clair dans MongoDB.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CREDENTIALS_ENCRYPTION_KEY=
